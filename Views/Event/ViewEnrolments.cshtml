@model List<RaceDayMVC.Models.Enrollment>
@{dfghjkl
    Layout = "_Layout";
}fghjkliuyt

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-danger fw-bold">Event Enrolments</h2>
        <a href="/Event/Index" class="btn btn-outline-secondary btn-sm">Back to Events</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info shadow-sm">
            No participants have enrolled in this event yet.
        </div>
    }
    else
    {
        <div class="card shadow">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Enrolment ID</th>
                            <th>Participant ID</th>
                            <th>Category</th>
                            <th>Enrolment Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td>@e.EnrollmentID</td>
                                <td>@e.ParticipantID</td>
                                <td>@e.Category</td>
                                <td>@e.EnrollmentDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (e.Status == "Confirmed")
                                    {
                                        <span class="badge bg-success">@e.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@e.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
