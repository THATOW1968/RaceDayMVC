@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mt-5">
    <h1 class="display-4 text-danger fw-bold">Welcome to RaceDay</h1>
    <p class="lead">The ultimate event management system for the SA running and cycling community.</p>
    <hr />

    @if (Context.Session.GetString("UserRole") != null)
    {
        <div class="alert alert-success">
            You are logged in as <strong>@Context.Session.GetString("UserEmail")</strong> (@Context.Session.GetString("UserRole"))
        </div>
        <a href="/Account/Logout" class="btn btn-outline-danger">Logout</a>
    }
    else
    {
        <a href="/Account/Login" class="btn btn-danger btn-lg mt-3">Login</a>
        <a href="/Account/Register" class="btn btn-outline-danger btn-lg mt-3">Register</a>
    }
</div>
